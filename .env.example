# Copy to .env and fill in. Generate random values with:  openssl rand -hex 24

# Password you type to log in to the app (phone or laptop)
APP_PASSWORD=change-me

# Random secrets
COOKIE_SECRET=
OPENWA_API_KEY=
WEBHOOK_SECRET=

# Pacing: random gap between messages (seconds) and max messages per day
MIN_DELAY_SEC=45
MAX_DELAY_SEC=120
DAILY_CAP=40
MAX_BATCH=10

TZ_APP=Asia/Kolkata

# Only for running the server outside Docker (npm run dev):
# OPENWA_URL=http://localhost:2785
